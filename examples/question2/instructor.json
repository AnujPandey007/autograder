{
    "problem": "sort_array_ascending",
    "time_limit_s": 1,
    "memory_limit_mb": 64,
    "metrics": [
        {
            "name": "correctness",
            "analyzer": "io_tests",
            "weight": 0.2,
            "params": {
                "testset_dir": "tests/sort/"
            }
        },
        {
            "name": "syntax",
            "analyzer": "compiler_warnings",
            "weight": 0.1,
            "params": {
                "flags": "-Wall -Wextra -Werror -std=c11"
            }
        },
        {
            "name": "structure",
            "analyzer": "static_analysis",
            "weight": 0.1,
            "params": {
                "max_cyclomatic": 8,
                "max_function_length": 40
            }
        },
        {
            "name": "modularity",
            "analyzer": "function_split",
            "weight": 0.1,
            "params": {
                "expect_helpers": true,
                "min_functions": 2
            }
        },
        {
            "name": "logical",
            "analyzer": "edge_case_runner",
            "weight": 0.1,
            "params": {
                "cases": [
                    "already_sorted",
                    "reverse_sorted",
                    "duplicates",
                    "negatives",
                    "single_element",
                    "all_equal"
                ]
            }
        },
        {
            "name": "complexity",
            "analyzer": "complexity_estimator",
            "weight": 0.1,
            "params": {
                "required": "O(n^2)",
                "sizes": [1, 10, 100]
            }
        },
        {
            "name": "memory_safety",
            "analyzer": "sanitizer_run",
            "weight": 0.1,
            "params": {
                "flags": "-fsanitize=address,undefined"
            }
        },
        {
            "name": "readability",
            "analyzer": "llm_review",
            "weight": 0.1,
            "params": {
                "model": "llama3.2:1b",
                "temperature": 0,
                "seed": 42
            }
        },
        {
            "name": "originality",
            "analyzer": "similarity_flag",
            "weight": 0.1,
            "params": {
                "corpus_dir": "submissions/",
                "flag_threshold": 0.85
            }
        }
    ]
}